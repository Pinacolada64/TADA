# ignore generated files
__pycache__/
run/
.venv/
# PyInstaller output for the standalone client (see tada-client.spec);
# rebuilt locally with `pyinstaller tada-client.spec`, and in CI by
# .github/workflows/build-client.yml
build/
dist/
tada-client-*.zip
# auto-created by config.py's ServerConfig on first instantiation if
# missing (sysop-editable server settings; local runtime data, not
# checked in)
server_config.json
# PyCharm settings:
.idea/
/tada-venv/
# bot session logs
*.log
bot_epic_battle_*.events.json
# tools/bot_credentials.py -- local-only test-account passwords, see that
# file's docstring
tools/.bot_credentials.json

# generated level maps (tools/gen_level_maps.py) -- regenerate, do not commit
tools/level_maps/
